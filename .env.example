# Core application configuration template
# Copy this file to .env and fill in local values. NEVER commit .env to version control!

# Flask Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change_this_to_a_secure_random_secret_in_development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=digital_library
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# MongoDB Configuration (Module 6 - Activity & Recommendations)
# Optional during baseline relational testing; can remain local or blank until Checkpoint 6
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=digital_library_events

# Circulation Business Rule Settings
MAX_BORROW_DAYS=14
MAX_RESERVATIONS_PER_USER=3
RESERVATION_EXPIRY_DAYS=2
DAILY_OVERDUE_FINE=1.00
